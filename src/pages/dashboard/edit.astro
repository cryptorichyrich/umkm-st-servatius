---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessForm from '../../components/react/BusinessForm.tsx';
import ProductManager from '../../components/react/ProductManager.tsx';

const businessId = Astro.url.searchParams.get('id') || '';
---

<BaseLayout title="Edit Usaha" noindex hideSearch>
  <BusinessForm client:load />
  <ProductManager client:idle businessId={businessId} />
</BaseLayout>
