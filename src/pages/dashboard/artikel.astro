---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogEditor from '../../components/react/BlogEditor.tsx';
---

<BaseLayout title="Artikel Saya" noindex>
  <section class="mx-auto max-w-4xl px-4 py-8">
    <nav class="mb-4 text-sm text-paroki-500">
      <a href="/dashboard" class="hover:text-paroki-700">Dashboard</a>
      <span class="mx-1.5 text-paroki-300">/</span>
      <span class="font-medium text-paroki-700">Artikel</span>
    </nav>
    <h1 class="mb-6 text-2xl font-bold text-paroki-900">Kelola Artikel</h1>
    <BlogEditor client:load />
  </section>
</BaseLayout>
