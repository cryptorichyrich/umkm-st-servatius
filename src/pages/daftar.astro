---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/react/AuthForm.tsx';

const title = 'Daftar Akun';
---

<BaseLayout title={title} noindex hideSearch>
  <section class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-soft">
        <!-- Header -->
        <div class="mb-6 text-center">
          <img src="/logo-umkm-hires.png" alt="UMKM St. Servatius" width="72" height="72" class="mx-auto mb-4 object-contain" />
          <h1 class="font-display text-2xl font-bold text-ink">Daftar Akun</h1>
          <p class="mt-1 text-sm text-paroki-600">
            Buat akun untuk mengelola usaha Anda di direktori paroki.
          </p>
        </div>

        <!-- Auth Form -->
        <AuthForm mode="register" client:load />
      </div>
    </div>
  </section>
</BaseLayout>
