---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/react/AuthForm.tsx';

const title = 'Daftar Akun';
---

<BaseLayout title={title}>
  <section class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="rounded-lg border border-paroki-200 bg-white p-8 shadow-soft">
        <!-- Header -->
        <div class="mb-6 text-center">
          <span class="mx-auto mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-paroki-600 text-paroki-50">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v2M11 4h2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <path d="M12 6 6.5 9.5V19h11V9.5L12 6Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M4.5 19h15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </span>
          <h1 class="font-display text-2xl font-bold text-paroki-900">Daftar Akun</h1>
          <p class="mt-1 text-sm text-paroki-600">
            Buat akun untuk mengelola usaha Anda di direktori paroki.
          </p>
        </div>

        <!-- Auth Form -->
        <AuthForm mode="register" client:load />

        <!-- Footer link -->
        <p class="mt-6 text-center text-sm text-paroki-600">
          Sudah punya akun?
          <a href="/masuk" class="ml-1 font-semibold text-paroki-700 hover:text-paroki-900 hover:underline">
            Masuk di sini
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
