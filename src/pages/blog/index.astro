---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogGrid from '../../components/react/BlogGrid.tsx';
---

<BaseLayout
  title="Blog UMKM"
  description="Artikel dan cerita dari UMKM Paroki St. Servatius. Tips, inspirasi, dan kabar terbaru dari para pelaku usaha."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Blog UMKM St. Servatius',
    description: 'Artikel dan cerita dari UMKM Paroki St. Servatius.',
    url: 'https://umkm-st-servatius.fxwisdom1.workers.dev/blog',
    isPartOf: {
      '@type': 'WebSite',
      name: 'UMKM St. Servatius',
      url: 'https://umkm-st-servatius.fxwisdom1.workers.dev',
    },
    mainEntity: {
      '@type': 'Blog',
      name: 'Blog UMKM Paroki St. Servatius',
      description: 'Artikel dan cerita dari pelaku UMKM Paroki St. Servatius.',
    },
  }}
>
  <section class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-4 text-sm text-gray-500">
      <a href="/" class="transition hover:text-paroki-700">Beranda</a>
      <span class="mx-2">/</span>
      <span class="font-medium text-paroki-700">Blog</span>
    </nav>

    <div class="mb-8">
      <h1 class="flex items-center gap-2.5 font-display text-3xl font-bold tracking-tight text-ink">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-paroki-50 text-paroki-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4z"/>
            <path d="M4 16h16"/>
            <path d="M8 8h6M8 12h4"/>
          </svg>
        </span>
        Blog UMKM
      </h1>
      <p class="mt-1.5 text-gray-600">Cerita, tips, dan kabar terbaru dari pelaku usaha Paroki St. Servatius.</p>
    </div>

    <BlogGrid client:load mode="all" />
  </section>
</BaseLayout>
