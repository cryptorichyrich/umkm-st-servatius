---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResetPassword from '../components/react/ResetPassword.tsx';

const title = 'Reset Kata Sandi';
---

<BaseLayout title={title} noindex>
  <section class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-soft">
        <ResetPassword client:load />
      </div>
    </div>
  </section>
</BaseLayout>
