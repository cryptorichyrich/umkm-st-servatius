---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/react/ProductGrid.tsx';
---

<BaseLayout title="Produk UMKM" description="Jelajahi produk dari UMKM Paroki St. Servatius.">
  <section class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-4 text-sm text-paroki-500">
      <a href="/" class="hover:text-paroki-700">Home</a>
      <span class="mx-2">/</span>
      <span class="text-paroki-700">Produk</span>
    </nav>

    <div class="mb-8">
      <h1 class="flex items-center gap-2.5 font-display text-3xl font-bold tracking-tight text-paroki-900">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-paroki-50 text-paroki-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z"/><path d="m4 7 8 4 8-4M12 11v10"/></svg>
        </span>
        Produk UMKM
      </h1>
      <p class="mt-1.5 text-paroki-600">Temukan produk dari umat paroki. Hubungi langsung via WhatsApp.</p>
    </div>

    <ProductGrid client:load mode="all" limit={12} />
  </section>
</BaseLayout>
