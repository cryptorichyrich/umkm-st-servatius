---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessGrid from '../../components/react/BusinessGrid.tsx';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

// ── Pre-render all category pages at build time ──
export async function getStaticPaths() {
  if (!isSupabaseConfigured) return [];
  const { data } = await supabase
    .from('categories')
    .select('id, slug, name');
  return (data || []).map((c: any) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const baseUrl = Astro.url.origin;
---

<BaseLayout
  title={category.name}
  description={`Usaha ${category.name} dari umat paroki.`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category.name} — UMKM Paroki St. Servatius`,
    description: `Usaha ${category.name} dari umat paroki.`,
    url: `${baseUrl}/kategori/${category.slug}`,
    isPartOf: {
      '@type': 'WebSite',
      name: 'UMKM St. Servatius',
      url: baseUrl,
    },
    mainEntity: {
      '@type': 'ItemList',
      name: `Usaha Kategori ${category.name}`,
    },
  }}
>
  <section class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-4 flex items-center gap-1.5 text-sm text-paroki-500">
      <a href="/" class="transition hover:text-paroki-700">Beranda</a>
      <span>/</span>
      <a href="/umkm" class="transition hover:text-paroki-700">UMKM</a>
      <span>/</span>
      <span class="font-medium text-paroki-700">{category.name}</span>
    </nav>

    <div class="mb-8 flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-gold-500 text-white">
        <CategoryIcon slug={category.slug} class="h-6 w-6" />
      </span>
      <div>
        <h1 class="font-display text-3xl font-bold tracking-tight text-ink">{category.name}</h1>
        <p class="mt-1 text-paroki-600">Jelajahi usaha dalam kategori ini.</p>
      </div>
    </div>

    <BusinessGrid client:load mode="category" categoryId={category.id} limit={12} />
  </section>
</BaseLayout>
