---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsDetail from '../../components/react/NewsDetail.tsx';

export async function getStaticPaths() {
  return [{ params: { slug: '_' } }];
}

const seoTitle = 'Berita UMKM St. Servatius';
const seoDesc = 'Berita UMKM Paroki St. Servatius, Kampung Sawah.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
