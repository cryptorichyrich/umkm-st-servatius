---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessGrid from '../../components/react/BusinessGrid.tsx';
---

<BaseLayout
  title="UMKM"
  description="Jelajahi semua usaha dan jasa dari umat paroki. Cari berdasarkan nama, kategori, atau wilayah."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'UMKM St. Servatius',
    description: 'Jelajahi semua usaha dan jasa dari umat paroki. Cari berdasarkan nama, kategori, atau wilayah.',
    url: 'https://umkm-st-servatius.fxwisdom1.workers.dev/umkm',
    isPartOf: {
      '@type': 'WebSite',
      name: 'UMKM St. Servatius',
      url: 'https://umkm-st-servatius.fxwisdom1.workers.dev',
    },
    mainEntity: {
      '@type': 'ItemList',
      name: 'UMKM Paroki St. Servatius',
      description: 'Daftar usaha dan jasa dari umat Paroki St. Servatius.',
    },
  }}
>
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="mb-8">
      <h1 class="font-display text-3xl font-bold tracking-tight text-ink">UMKM Paroki St. Servatius</h1>
      <p class="mt-2 text-paroki-600">
        Temukan usaha dan jasa dari umat paroki kita.
      </p>
    </div>

    <BusinessGrid client:load mode="full" limit={12} />
  </section>
</BaseLayout>
