---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/react/AuthForm.tsx';

const title = 'Masuk';
---

<BaseLayout title={title}>
  <section class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="rounded-2xl border border-paroki-200 bg-white p-8 shadow-lg">
        <!-- Header -->
        <div class="mb-6 text-center">
          <div class="mb-2 text-4xl">⛪</div>
          <h1 class="font-serif text-2xl font-bold text-paroki-900">Masuk</h1>
          <p class="mt-1 text-sm text-paroki-600">
            Selamat datang kembali! Masuk untuk mengelola usaha Anda.
          </p>
        </div>

        <!-- Auth Form -->
        <AuthForm mode="login" client:load />

        <!-- Footer link -->
        <p class="mt-6 text-center text-sm text-paroki-600">
          Belum punya akun?
          <a href="/daftar" class="ml-1 font-semibold text-paroki-700 hover:text-paroki-900 hover:underline">
            Daftar di sini
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
