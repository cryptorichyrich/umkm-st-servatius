---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminPanel from '../../components/react/AdminPanel.tsx';

// ── Pre-generate all admin tab routes for client-side routing ──
export async function getStaticPaths() {
  const tabs = [
    'moderasi', 'verifikasi', 'listing', 'kategori', 'wilayah',
    'users', 'reviews', 'laporan', 'bazar', 'berita', 'moderasi-blog', 'log',
    'keamanan', 'email',
  ];
  // Root: /admin/ (no path param)
  const paths = [{ params: { path: undefined } }];
  // Sub-routes: /admin/moderasi, /admin/verifikasi, etc.
  for (const tab of tabs) {
    paths.push({ params: { path: tab } });
  }
  return paths;
}

const title = 'Admin Panel';
---

<BaseLayout title={title} noindex hideSearch>
  <AdminPanel client:only="react" />
</BaseLayout>
