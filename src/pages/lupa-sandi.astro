---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import ForgotPassword from '../components/react/ForgotPassword.tsx';

const title = 'Lupa Kata Sandi';
---

<BaseLayout title={title} noindex hideSearch>
  <section class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-soft">
        <div class="mb-6 text-center">
          <img src="/logo-umkm-hires.png" alt="UMKM St. Servatius" width="72" height="72" class="mx-auto mb-4 object-contain" />
          <h1 class="font-display text-2xl font-bold text-ink">Lupa Kata Sandi?</h1>
          <p class="mt-1 text-sm text-paroki-600">
            Masukkan email Anda. Kami akan mengirim tautan untuk mengatur ulang kata sandi.
          </p>
        </div>

        <ForgotPassword client:load />

        <p class="mt-6 text-center text-sm text-paroki-600">
          Ingat kata sandi Anda?
          <a href="/masuk" class="ml-1 font-semibold text-paroki-700 hover:text-paroki-900 hover:underline">
            Masuk di sini
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
