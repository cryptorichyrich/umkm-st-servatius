---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessGrid from '../components/react/BusinessGrid.tsx';

// Default categories for static render (will also be fetched client-side)
const defaultCategories = [
  { name: 'Kuliner & Minuman', slug: 'kuliner-minuman', icon: '🍜' },
  { name: 'Jasa & Service', slug: 'jasa-service', icon: '🔧' },
  { name: 'Kerajinan Tangan', slug: 'kerajinan-tangan', icon: '✂️' },
  { name: 'Fashion & Pakaian', slug: 'fashion-pakaian', icon: '👕' },
  { name: 'Kecantikan & Kesehatan', slug: 'kecantikan-kesehatan', icon: '💄' },
  { name: 'Elektronik & Gadget', slug: 'elektronik-gadget', icon: '📱' },
  { name: 'Pendidikan & Les', slug: 'pendidikan-les', icon: '📚' },
  { name: 'Pertanian & Peternakan', slug: 'pertanian-peternakan', icon: '🌱' },
  { name: 'Otomotif', slug: 'otomotif', icon: '🚗' },
  { name: 'Lainnya', slug: 'lainnya', icon: '📦' },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-paroki-100 via-paroki-50 to-white py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <div class="mb-4 text-5xl">⛪</div>
      <h1 class="font-serif text-3xl font-bold text-paroki-900 md:text-5xl">
        Direktori UMKM Paroki
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-paroki-600 md:text-lg">
        Temukan usaha dan jasa dari sesama umat paroki. Dari kuliner, kerajinan,
        hingga jasa service — semuanya ada di sini. Mari saling mendukung!
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/direktori"
          class="w-full rounded-xl bg-paroki-600 px-6 py-3 text-center font-semibold text-white shadow-md transition hover:bg-paroki-700 sm:w-auto"
        >
          🔍 Jelajahi Direktori
        </a>
        <a
          href="/daftar"
          class="w-full rounded-xl border border-paroki-300 bg-white px-6 py-3 text-center font-semibold text-paroki-700 transition hover:bg-paroki-50 sm:w-auto"
        >
          📝 Daftarkan Usaha Anda
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section id="kategori" class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-6 font-serif text-2xl font-bold text-paroki-900">Kategori Usaha</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {defaultCategories.map((cat) => (
        <a
          href={`/kategori/${cat.slug}`}
          class="flex flex-col items-center gap-2 rounded-xl border border-paroki-200 bg-white p-4 text-center shadow-sm transition hover:border-paroki-300 hover:shadow-md"
        >
          <span class="text-3xl">{cat.icon}</span>
          <span class="text-xs font-medium text-paroki-700">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured UMKM -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="font-serif text-2xl font-bold text-paroki-900">UMKM Pilihan</h2>
      <a href="/direktori" class="text-sm font-medium text-paroki-600 hover:text-paroki-800">
        Lihat semua →
      </a>
    </div>
    <BusinessGrid client:load mode="featured" limit={8} />
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="overflow-hidden rounded-3xl bg-gradient-to-r from-paroki-600 to-paroki-800 px-6 py-12 text-center md:px-12">
      <h2 class="font-serif text-2xl font-bold text-white md:text-3xl">
        Punya Usaha? Daftarkan Sekarang!
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-paroki-100">
        Gratis selamanya. Promosikan usaha Anda kepada ratusan keluarga di paroki kita.
        Daftar, upload foto, dan mulai dapat pelanggan baru.
      </p>
      <a
        href="/daftar"
        class="mt-6 inline-block rounded-xl bg-white px-8 py-3 font-semibold text-paroki-700 shadow-lg transition hover:bg-paroki-50"
      >
        Daftar Gratis →
      </a>
    </div>
  </section>
</BaseLayout>
