---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessGrid from '../components/react/BusinessGrid.tsx';
import CategoryIcon from '../components/CategoryIcon.astro';

const defaultCategories = [
  { name: 'Kuliner & Minuman', slug: 'kuliner-minuman' },
  { name: 'Jasa & Service', slug: 'jasa-service' },
  { name: 'Kerajinan Tangan', slug: 'kerajinan-tangan' },
  { name: 'Fashion & Pakaian', slug: 'fashion-pakaian' },
  { name: 'Kecantikan & Kesehatan', slug: 'kecantikan-kesehatan' },
  { name: 'Elektronik & Gadget', slug: 'elektronik-gadget' },
  { name: 'Pendidikan & Les', slug: 'pendidikan-les' },
  { name: 'Pertanian & Peternakan', slug: 'pertanian-peternakan' },
  { name: 'Otomotif', slug: 'otomotif' },
  { name: 'Lainnya', slug: 'lainnya' },
];
---

<BaseLayout
  description="Direktori UMKM Paroki St. Servatius — Temukan usaha dan jasa umat paroki. Kuliner, jasa, kerajinan, dan lainnya dari sesama umat."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'UMKM St. Servatius',
      url: 'https://umkm-st-servatius.fxwisdom1.workers.dev',
      description: 'Direktori UMKM Paroki St. Servatius — Temukan usaha dan jasa umat paroki',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'UMKM St. Servatius',
      url: 'https://umkm-st-servatius.fxwisdom1.workers.dev',
      description: 'Direktori usaha dan jasa UMKM umat Paroki St. Servatius, Kampung Sawah.',
      areaServed: 'Paroki Santo Servatius, Kampung Sawah',
    },
  ]}
>
  <!-- Hero — light, clean, with green accent stripe -->
  <section class="border-b border-gray-100 bg-paroki-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="max-w-2xl">
        <div class="mb-5 flex items-center gap-2.5">
          <span class="h-px w-8 bg-gold-500"></span>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-600">Paroki Kampung Sawah</span>
        </div>
        <h1 class="font-display text-3xl font-extrabold leading-[1.12] tracking-tight text-ink md:text-[2.6rem]">
          Usaha umat, saling mendukung.
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-gray-600 md:text-lg">
          Temukan kuliner, jasa, dan kerajinan dari sesama umat paroki. Belanja dari tetangga, bertumbuh bersama.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href="/direktori"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-gold-500 px-6 py-3 font-bold text-white transition hover:bg-gold-600 active:translate-y-px"
          >
            Jelajahi Direktori
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a
            href="/daftar"
            class="inline-flex items-center justify-center rounded-lg border border-paroki-300 bg-white px-6 py-3 font-semibold text-paroki-800 transition hover:border-paroki-500 hover:bg-paroki-50 active:translate-y-px"
          >
            Daftarkan Usaha Anda
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section id="kategori" class="mx-auto max-w-6xl px-4 py-14 md:py-16">
    <div class="mb-7 flex items-end justify-between">
      <div>
        <h2 class="font-display text-2xl font-bold text-ink">Kategori Usaha</h2>
        <p class="mt-1 text-sm text-gray-500">Pilih kategori untuk mulai menjelajah.</p>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {defaultCategories.map((cat) => (
        <a
          href={`/kategori/${cat.slug}`}
          class="group flex flex-col items-center gap-3 rounded-lg border border-gray-200 bg-white p-5 text-center transition hover:border-gold-400 hover:shadow-soft"
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-paroki-50 text-paroki-700 transition group-hover:bg-gold-500 group-hover:text-white">
            <CategoryIcon slug={cat.slug} class="h-6 w-6" />
          </span>
          <span class="text-[13px] font-semibold leading-tight text-ink">{cat.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured UMKM -->
  <section class="mx-auto max-w-6xl px-4 pb-14 md:pb-16">
    <div class="mb-7 flex items-end justify-between">
      <h2 class="font-display text-2xl font-bold text-ink">UMKM Pilihan</h2>
      <a href="/direktori" class="inline-flex items-center gap-1 text-sm font-semibold text-paroki-700 transition hover:text-paroki-900">
        Lihat semua
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
      </a>
    </div>
    <BusinessGrid client:load mode="featured" limit={8} />
  </section>

  <!-- CTA — green section -->
  <section class="bg-paroki-900">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <h2 class="font-display text-2xl font-bold text-white md:text-3xl">
            Punya usaha? Mari bergabung.
          </h2>
          <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-paroki-200">
            Gratis selamanya. Promosikan usaha Anda kepada ratusan keluarga di paroki kita.
          </p>
        </div>
        <a
          href="/daftar"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-gold-500 px-7 py-3.5 font-bold text-white transition hover:bg-gold-600 active:translate-y-px"
        >
          Daftar Gratis
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
