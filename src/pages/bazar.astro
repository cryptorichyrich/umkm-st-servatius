---
import BaseLayout from '../layouts/BaseLayout.astro';
import BazarPublic from '../components/react/BazarPublic.tsx';
---

<BaseLayout
  title="Jadwal Bazar UMKM"
  description="Lihat jadwal bazar UMKM Paroki St. Servatius dan siapa saja yang berjualan."
>
  <section class="mx-auto max-w-4xl px-4 py-8">
    <nav class="mb-4 text-sm text-paroki-500">
      <a href="/" class="hover:text-paroki-700">Home</a>
      <span class="mx-2">/</span>
      <span class="text-paroki-700">Bazar</span>
    </nav>

    <div class="mb-8">
      <h1 class="flex items-center gap-2.5 font-display text-3xl font-bold tracking-tight text-ink">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-gold-100 text-gold-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 21 14 3"/><path d="M3.5 21h17"/><path d="M4.5 21c0-5 3-8 8-8"/><path d="M14 3c4 3 6 7 6 11"/></svg>
        </span>
        Bazar UMKM
      </h1>
      <p class="mt-1.5 text-paroki-600">Jadwal bazar dan daftar peserta UMKM Paroki St. Servatius.</p>
    </div>

    <BazarPublic client:load />
  </section>
</BaseLayout>
