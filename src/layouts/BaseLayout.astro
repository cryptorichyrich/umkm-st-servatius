---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description = 'Direktori usaha dan jasa UMKM umat Paroki St. Servatius. Saling mendukung ekonomi komunitas paroki.',
  image,
  canonical,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = 'UMKM St. Servatius';
const baseUrl = 'https://umkm-st-servatius.fxwisdom1.workers.dev';
const isHomepage = !title || title === siteName;
const fullTitle = isHomepage ? siteName : `${title} | ${siteName}`;
const canonicalUrl = canonical || Astro.url.href;
const ogImage = image || `${baseUrl}/og-default.jpg`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Basic meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots -->
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

    <!-- Theme color -->
    <meta name="theme-color" content="#15803d" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Plus Jakarta Sans (display) + Source Sans 3 (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Load Supabase config from Worker runtime env (dynamic, not baked at build) -->
    <script is:inline src="/__env.js"></script>
  </head>
  <body>
    <!-- Header — clean white bar -->
    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-paroki-900 text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v2M11 4h2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              <path d="M12 6 6.5 9.5V19h11V9.5L12 6Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M10 19v-3.5a2 2 0 0 1 4 0V19" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
              <path d="M4.5 19h15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="flex flex-col leading-none">
            <span class="font-display text-[15px] font-extrabold tracking-tight text-ink">UMKM St. Servatius</span>
            <span class="text-[11px] font-medium text-paroki-600">Paroki Kampung Sawah</span>
          </span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden items-center gap-1 md:flex">
          <a href="/umkm" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800">UMKM</a>
          <a href="/produk" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800">Produk</a>
          <a href="/bazar" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800">Bazar</a>

          <!-- Dropdown: Artikel [Berita, Blog] -->
          <div class="relative nav-dropdown" id="dd-artikel">
            <button class="nav-dd-btn flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800">
              Artikel
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-dd-menu invisible absolute left-0 top-full z-50 mt-1 w-44 translate-y-1 rounded-xl border border-gray-200 bg-white py-1.5 opacity-0 shadow-lg transition-all duration-150">
              <a href="/berita" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-paroki-50">📰 Berita</a>
              <a href="/blog" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-paroki-50">📝 Blog UMKM</a>
            </div>
          </div>

          <!-- Logged out: Masuk + Daftar -->
          <div id="nav-auth-buttons" class="nav-guest-only flex items-center gap-2 border-l border-gray-200 pl-3 ml-2">
            <a href="/masuk" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800">Masuk</a>
            <a href="/daftar" class="inline-flex items-center gap-1.5 rounded-lg bg-gold-500 px-4 py-2 text-sm font-bold text-white transition hover:bg-gold-600 active:translate-y-px">Daftar</a>
          </div>

          <!-- Logged in: Akun dropdown (populated by script) -->
          <div id="nav-auth-area" class="hidden"></div>
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="rounded-lg p-2 text-gray-600 transition hover:bg-gray-100 md:hidden"
          aria-label="Buka menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white px-4 py-3 md:hidden">
        <div class="flex flex-col gap-1">
          <a href="/umkm" class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">UMKM</a>
          <a href="/produk" class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">Produk</a>
          <a href="/bazar" class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">Bazar</a>
          <a href="/berita" class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">📰 Berita</a>
          <a href="/blog" class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">📝 Blog UMKM</a>
          <!-- Mobile auth area (populated by script) -->
          <div id="mobile-auth-area" class="mt-2 border-t border-gray-100 pt-2 flex flex-col gap-1"></div>
          <div id="mobile-auth-guest" class="nav-guest-only flex flex-col gap-1">
            <a href="/masuk" class="rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">Masuk</a>
            <a href="/daftar" class="mt-1 rounded-lg bg-gold-500 px-3 py-2.5 text-center text-sm font-bold text-white">Daftar</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer — deep green -->
    <footer class="bg-paroki-900 text-paroki-100">
      <div class="mx-auto max-w-6xl px-4 py-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="max-w-xs">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/10 text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3v2M11 4h2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                  <path d="M12 6 6.5 9.5V19h11V9.5L12 6Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                  <path d="M4.5 19h15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="font-display text-sm font-bold text-white">{siteName}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-paroki-200">
              Direktori usaha dan jasa dari umat Paroki St. Servatius, Kampung Sawah. Saling mendukung ekonomi komunitas paroki.
            </p>
          </div>
          <div class="flex flex-col gap-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-paroki-300">Jelajahi</span>
            <a href="/umkm" class="text-paroki-100 transition hover:text-white">UMKM</a>
            <a href="/produk" class="text-paroki-100 transition hover:text-white">Produk</a>
            <a href="/berita" class="text-paroki-100 transition hover:text-white">Berita</a>
            <a href="/blog" class="text-paroki-100 transition hover:text-white">Blog</a>
            <a href="/daftar" class="text-paroki-100 transition hover:text-white">Daftarkan Usaha</a>
            <a href="/dashboard" class="text-paroki-100 transition hover:text-white">Dashboard</a>
          </div>
        </div>
        <div class="mt-8 border-t border-white/10 pt-5">
          <p class="text-xs text-paroki-300">
            © {year} {siteName} · Paroki Santo Servatius, Kampung Sawah
          </p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle + Desktop dropdowns -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

      // Generic dropdown handler — works for ALL .nav-dropdown elements
      document.querySelectorAll('.nav-dropdown').forEach((dd) => {
        const ddBtn = dd.querySelector('.nav-dd-btn');
        const ddMenu = dd.querySelector('.nav-dd-menu');
        if (!ddBtn || !ddMenu) return;

        const open = () => {
          ddMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1');
          ddMenu.classList.add('opacity-100', 'translate-y-0');
        };
        const close = () => {
          ddMenu.classList.add('invisible', 'opacity-0', 'translate-y-1');
          ddMenu.classList.remove('opacity-100', 'translate-y-0');
        };

        ddBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          // Close all other dropdowns first
          document.querySelectorAll('.nav-dd-menu').forEach((m) => {
            if (m !== ddMenu) {
              m.classList.add('invisible', 'opacity-0', 'translate-y-1');
              m.classList.remove('opacity-100', 'translate-y-0');
            }
          });
          if (ddMenu.classList.contains('opacity-0')) open(); else close();
        });
        dd.addEventListener('mouseenter', open);
        dd.addEventListener('mouseleave', close);
      });

      // Close all dropdowns on outside click
      document.addEventListener('click', () => {
        document.querySelectorAll('.nav-dd-menu').forEach((m) => {
          m.classList.add('invisible', 'opacity-0', 'translate-y-1');
          m.classList.remove('opacity-100', 'translate-y-0');
        });
      });
    </script>

    <!-- Auth-aware navbar -->
    <script type="module">
      async function updateNav() {
        if (!window.__SUPABASE__) {
          setTimeout(updateNav, 200);
          return;
        }

        try {
          const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
          const sb = createClient(window.__SUPABASE__.url, window.__SUPABASE__.key, { auth: { persistSession: true } });
          window.sb = sb;

          const { data: { session } } = await sb.auth.getSession();

          if (!session) {
            // Guest: Masuk + Daftar already visible by default
            return;
          }

          // Logged in: fetch profile
          const { data: profile } = await sb
            .from('profiles')
            .select('full_name, role, verification_status, verification_type')
            .eq('id', session.user.id)
            .single();

          const role = profile?.role || 'member';
          const isAdmin = role === 'admin';
          const fullName = profile?.full_name || 'Akun';
          const initials = fullName.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();

          // Hide guest-only elements
          document.querySelectorAll('.nav-guest-only').forEach(el => el.classList.add('hidden'));

          // ── Desktop: Akun dropdown ──
          const desktopArea = document.getElementById('nav-auth-area');
          const desktopButtons = document.getElementById('nav-auth-buttons');

          if (desktopArea) {
            desktopArea.innerHTML = `
              <button class="nav-dd-btn flex items-center gap-2 rounded-lg border border-gray-200 px-2.5 py-1.5 text-sm font-medium text-gray-700 transition hover:bg-paroki-50">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-paroki-900 text-xs font-bold text-white">${initials}</span>
                <span class="max-w-[100px] truncate">${fullName}</span>
                <svg class="h-3.5 w-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="nav-dd-menu invisible absolute right-0 top-full z-50 mt-1 w-52 translate-y-1 rounded-xl border border-gray-200 bg-white py-1.5 opacity-0 shadow-lg transition-all duration-150">
                <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">
                  <svg class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                  Dashboard
                </a>
                ${isAdmin ? '<a href="/admin" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-paroki-700 hover:bg-paroki-50"><svg class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>Admin Panel</a>' : ''}
                <div class="my-1 border-t border-gray-100"></div>
                <button onclick="(async()=>{await sb.auth.signOut();window.location.href='/'})()" class="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-red-600 hover:bg-red-50">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                  Keluar
                </button>
              </div>
            `;
            desktopArea.classList.remove('hidden');
            desktopArea.classList.add('relative', 'nav-dropdown');

            // Wire up the newly injected dropdown
            const ddBtn = desktopArea.querySelector('.nav-dd-btn');
            const ddMenu = desktopArea.querySelector('.nav-dd-menu');
            if (ddBtn && ddMenu) {
              const open = () => { ddMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1'); ddMenu.classList.add('opacity-100', 'translate-y-0'); };
              const close = () => { ddMenu.classList.add('invisible', 'opacity-0', 'translate-y-1'); ddMenu.classList.remove('opacity-100', 'translate-y-0'); };
              ddBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                document.querySelectorAll('.nav-dd-menu').forEach((m) => { if (m !== ddMenu) { m.classList.add('invisible', 'opacity-0', 'translate-y-1'); m.classList.remove('opacity-100', 'translate-y-0'); } });
                if (ddMenu.classList.contains('opacity-0')) open(); else close();
              });
              desktopArea.addEventListener('mouseenter', open);
              desktopArea.addEventListener('mouseleave', close);
            }
          }
          if (desktopButtons) desktopButtons.classList.add('hidden');

          // ── Mobile auth area ──
          const mobileArea = document.getElementById('mobile-auth-area');
          const mobileGuest = document.getElementById('mobile-auth-guest');
          if (mobileArea) {
            mobileArea.innerHTML = `
              <a href="/dashboard" class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">📊 Dashboard</a>
              ${isAdmin ? '<a href="/admin" class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-bold text-paroki-700 hover:bg-paroki-50">⚙️ Admin Panel</a>' : ''}
              <button onclick="(async()=>{await sb.auth.signOut();window.location.href='/'})()" class="mt-1 flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-red-600 hover:bg-red-50">
                🚪 Keluar
              </button>
            `;
          }
          if (mobileGuest) mobileGuest.classList.add('hidden');

        } catch (e) {
          // Silently fail — guest view is default
        }
      }

      updateNav();
    </script>
  </body>
</html>
