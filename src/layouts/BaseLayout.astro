---
import '../styles/global.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: object | object[];
  hideSearch?: boolean;
}

const {
  title,
  description = 'Direktori usaha dan jasa UMKM umat Paroki St. Servatius. Saling mendukung ekonomi komunitas paroki.',
  image,
  canonical,
  type = 'website',
  noindex = false,
  jsonLd,
  hideSearch = false,
} = Astro.props;

const siteName = 'UMKM St. Servatius';
const baseUrl = Astro.url.origin;
const isHomepage = !title || title === siteName;
const fullTitle = isHomepage ? siteName : `${title} | ${siteName}`;
const canonicalUrl = canonical || Astro.url.href;
const ogImage = image || `${baseUrl}/og-default.jpg`;
const year = new Date().getFullYear();

// Inject Supabase config for client-side
// In SSR: use the hardcoded publishable key (it's public, not secret)
// In client: window.__SUPABASE__ is set by this inline script
const sbUrl = 'https://vfqcydqmwhfelqizxzbi.supabase.co';
const sbKey = 'sb_publishable_jph_9XaA6S_pIuVdOYaTkA_TCak_Oz4';
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Basic meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots -->
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

    <!-- Theme color -->
    <meta name="theme-color" content="#15803d" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="UMKM Servatius" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Blog UMKM St. Servatius" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: self-hosted via @fontsource (no external CDN) -->

    <!-- JSON-LD structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Load Supabase config from Worker runtime env (dynamic, not baked at build) -->
    <script is:inline define:vars={{ sbUrl, sbKey }}>
      // Clear any stale dark mode from previous toggle
      localStorage.removeItem('theme');
      document.documentElement.classList.remove('dark');
      window.__SUPABASE__ = { url: sbUrl, key: sbKey };
    </script>
  </head>
  <body>
    <!-- Top announcement bar — gold accent stripe -->
    <div class="hidden bg-paroki-900 text-gold-200 md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-center gap-2 px-4 py-1.5 text-xs">
        <span class="text-gold-400">✦</span>
        <p class="font-medium tracking-wide">Bersatu Membangun Ekonomi Umat Paroki St. Servatius</p>
        <span class="text-gold-400">✦</span>
      </div>
    </div>

    <!-- Main header — brand left, medallion center, menu right -->
    <header class="sticky top-0 z-50 border-b border-perak-200 bg-white shadow-soft backdrop-blur-md">
      <div class="h-0.5 w-full bg-gradient-to-r from-paroki-700 via-gold-400 to-merah-700"></div>
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2.5">
        <!-- Left: Brand text -->
        <a href="/" class="flex flex-col leading-tight">
          <span class="font-display text-base font-extrabold tracking-tight text-paroki-800 md:text-lg">UMKM St. Servatius</span>
          <span class="bg-gradient-to-r from-gold-200 via-gold-400 to-gold-300 bg-clip-text text-[11px] font-semibold tracking-wide text-transparent md:text-xs">Paroki Kampung Sawah</span>
        </a>

        <!-- Right: Nav links + auth, all pushed right -->
        <div class="hidden items-center gap-1 md:flex">
          <a href="/umkm" class="rounded-lg px-3 py-2 text-sm font-semibold text-perak-700 transition hover:bg-paroki-50 hover:text-paroki-800">UMKM</a>
          <a href="/produk" class="rounded-lg px-3 py-2 text-sm font-semibold text-perak-700 transition hover:bg-paroki-50 hover:text-paroki-800">Produk</a>
          <a href="/bazar" class="rounded-lg px-3 py-2 text-sm font-semibold text-perak-700 transition hover:bg-paroki-50 hover:text-paroki-800">Bazar</a>

          <!-- Dropdown: Artikel [Berita, Blog] -->
          <div class="relative nav-dropdown" id="dd-artikel">
            <button class="nav-dd-btn flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-semibold text-perak-700 transition hover:bg-paroki-50 hover:text-paroki-800">
              Artikel
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-dd-menu invisible absolute right-0 top-full z-50 mt-1.5 w-48 translate-y-1 rounded-2xl border border-perak-200 bg-white py-2 opacity-0 shadow-xl transition-all duration-150">
              <a href="/berita" class="block px-4 py-2.5 text-sm font-medium text-perak-700 transition hover:bg-paroki-50 hover:text-paroki-800">Berita</a>
              <a href="/blog" class="block px-4 py-2.5 text-sm font-medium text-perak-700 transition hover:bg-paroki-50 hover:text-paroki-800">Blog UMKM</a>
            </div>
          </div>

          <div class="mx-1 h-6 w-px bg-perak-200"></div>

          <div id="nav-auth-buttons" class="nav-guest-only flex items-center gap-2">
            <a href="/masuk" class="rounded-lg px-3 py-2 text-sm font-semibold text-perak-600 transition hover:bg-paroki-50 hover:text-paroki-800">Masuk</a>
            <a href="/daftar" class="inline-flex items-center gap-1.5 rounded-xl bg-gold-500 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-gold-600 hover:shadow-md active:translate-y-px">Daftar</a>
          </div>
          <div id="nav-notif-area" class="hidden relative"></div>
          <div id="nav-auth-area" class="hidden"></div>
        </div>

        <!-- Mobile: hamburger -->
        <button
          id="mobile-menu-btn"
          class="rounded-xl p-2 text-perak-700 transition hover:bg-perak-100 md:hidden"
          aria-label="Buka menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </nav>

      <!-- Hanging centered logo (medallion) -->
      <a href="/" class="absolute bottom-0 left-1/2 z-50 flex -translate-x-1/2 translate-y-1/2 flex-col items-center" aria-label="UMKM St. Servatius — Beranda">
        <img src="/logo-umkm-hires.png" alt="Logo UMKM St. Servatius" class="h-12 w-12 object-contain drop-shadow-md transition hover:scale-105 md:h-16 md:w-16" />
      </a>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-perak-200 bg-white px-4 py-3 md:hidden">
        <div class="flex flex-col gap-1">
          <a href="/umkm" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-perak-700 hover:bg-paroki-50">UMKM</a>
          <a href="/produk" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-perak-700 hover:bg-paroki-50">Produk</a>
          <a href="/bazar" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-perak-700 hover:bg-paroki-50">Bazar</a>
          <a href="/berita" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-perak-700 hover:bg-paroki-50">Berita</a>
          <a href="/blog" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-perak-700 hover:bg-paroki-50">Blog UMKM</a>
        </div>
        <div id="mobile-auth-area" class="mt-2 border-t border-perak-200 pt-2 flex flex-col gap-1"></div>
        <div id="mobile-auth-guest" class="nav-guest-only mt-2 border-t border-perak-200 pt-2 flex flex-col gap-1">
          <a href="/masuk" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-perak-600 hover:bg-paroki-50">Masuk</a>
          <a href="/daftar" class="mt-1 rounded-xl bg-gold-500 px-3 py-2.5 text-center text-sm font-bold text-white">Daftar</a>
        </div>
      </div>
    </header>

    <!-- Global search bar (hidden on homepage + admin) -->
    {!hideSearch && (
      <div class="border-b border-gold-200/60 bg-gradient-to-b from-gold-50/50 to-transparent pt-8 md:pt-10">
        <div class="mx-auto max-w-6xl px-4 pb-2">
          <form action="/produk" method="get" class="flex items-center gap-2 py-2">
            <div class="relative flex-1">
              <svg class="absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-gold-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3"/></svg>
              <input type="text" name="q" placeholder="Cari produk, jasa, atau usaha..." class="w-full rounded-full border border-gold-200 bg-white/90 py-2.5 pl-11 pr-4 text-sm text-ink outline-none transition placeholder:text-perak-400 focus:border-gold-400 focus:bg-white focus:ring-2 focus:ring-gold-100 shadow-sm" />
            </div>
            <button type="submit" class="inline-flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-gold-400 to-gold-500 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:from-gold-500 hover:to-gold-600 hover:shadow-md active:translate-y-px">
              Cari
            </button>
          </form>
        </div>
      </div>
    )}

    <!-- Main content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer — deep green with gold accents -->
    <footer class="bg-paroki-900 text-paroki-100">
      <div class="h-1 w-full bg-gradient-to-r from-merah-700 via-gold-400 to-merah-700"></div>
      <div class="mx-auto max-w-6xl px-4 py-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="max-w-sm">
            <div class="flex items-center gap-3">
              <img src="/logo-umkm-hires.png" alt="Logo UMKM St. Servatius" class="h-20 w-20 object-contain" />
              <div class="flex flex-col">
                <span class="font-display text-lg font-bold text-white">{siteName}</span>
                <span class="text-xs font-medium text-gold-300">Paroki Kampung Sawah</span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-paroki-200">
              Direktori usaha dan jasa dari umat Paroki St. Servatius, Kampung Sawah. Saling mendukung ekonomi komunitas paroki.
            </p>
          </div>
          <div class="flex flex-col gap-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-gold-300">Jelajahi</span>
            <a href="/umkm" class="text-paroki-100 transition hover:text-gold-200">UMKM</a>
            <a href="/produk" class="text-paroki-100 transition hover:text-gold-200">Produk</a>
            <a href="/berita" class="text-paroki-100 transition hover:text-gold-200">Berita</a>
            <a href="/blog" class="text-paroki-100 transition hover:text-gold-200">Blog</a>
            <a href="/daftar" class="text-paroki-100 transition hover:text-gold-200">Daftarkan Usaha</a>
            <a href="/dashboard" class="text-paroki-100 transition hover:text-gold-200">Dashboard</a>
          </div>
          <div class="flex flex-col gap-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-gold-300">Informasi</span>
            <a href="/syarat-ketentuan" class="text-paroki-100 transition hover:text-gold-200">Syarat &amp; Ketentuan</a>
            <a href="/kebijakan-privasi" class="text-paroki-100 transition hover:text-gold-200">Kebijakan Privasi</a>
          </div>
        </div>
        <div class="mt-8 border-t border-gold-400/20 pt-5">
          <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-paroki-300">
              © {year} {siteName} · Paroki Santo Servatius, Kampung Sawah
            </p>
            <p class="text-xs text-paroki-300">
              Bersinergi dengan seksi IT Paroki Kampung Sawah dengan ❤️
            </p>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle + Desktop dropdowns -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');

      function setMenuOpen(open: boolean) {
        if (!menu || !btn) return;
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
      }

      btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.contains('hidden') === false;
        setMenuOpen(!isOpen);
      });

      // Close mobile menu when a link inside it is clicked
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenuOpen(false)));

      // Escape closes mobile menu and all dropdowns
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setMenuOpen(false);
          document.querySelectorAll('.nav-dd-menu').forEach((m) => {
            m.classList.add('invisible', 'opacity-0', 'translate-y-1');
            m.classList.remove('opacity-100', 'translate-y-0');
          });
        }
      });

      // Generic dropdown handler — works for ALL .nav-dropdown elements
      document.querySelectorAll('.nav-dropdown').forEach((dd) => {
        const ddBtn = dd.querySelector('.nav-dd-btn');
        const ddMenu = dd.querySelector('.nav-dd-menu');
        if (!ddBtn || !ddMenu) return;

        const open = () => {
          ddMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1');
          ddMenu.classList.add('opacity-100', 'translate-y-0');
          ddBtn?.setAttribute('aria-expanded', 'true');
        };
        const close = () => {
          ddMenu.classList.add('invisible', 'opacity-0', 'translate-y-1');
          ddMenu.classList.remove('opacity-100', 'translate-y-0');
          ddBtn?.setAttribute('aria-expanded', 'false');
        };

        ddBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          // Close all other dropdowns first
          document.querySelectorAll('.nav-dd-menu').forEach((m) => {
            if (m !== ddMenu) {
              m.classList.add('invisible', 'opacity-0', 'translate-y-1');
              m.classList.remove('opacity-100', 'translate-y-0');
            }
          });
          if (ddMenu.classList.contains('opacity-0')) open(); else close();
        });
        dd.addEventListener('mouseenter', open);
        dd.addEventListener('mouseleave', close);
        // Keyboard: Enter/Space already handled by <button>, Escape closes
        ddBtn.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      });

      // Close all dropdowns on outside click
      document.addEventListener('click', () => {
        document.querySelectorAll('.nav-dd-menu').forEach((m) => {
          m.classList.add('invisible', 'opacity-0', 'translate-y-1');
          m.classList.remove('opacity-100', 'translate-y-0');
        });
      });

    </script>

    <!-- Auth-aware navbar -->
    <script type="module">
      import { createClient } from '@supabase/supabase-js';

      async function updateNav() {
        if (!window.__SUPABASE__) {
          setTimeout(updateNav, 200);
          return;
        }

        try {
          const sb = createClient(window.__SUPABASE__.url, window.__SUPABASE__.key, { auth: { persistSession: true } });
          window.sb = sb;

          const { data: { session } } = await sb.auth.getSession();

          if (!session) {
            // Guest: Masuk + Daftar already visible by default
            return;
          }

          // Logged in: fetch profile
          const { data: profile } = await sb
            .from('profiles')
            .select('full_name, role, verification_status, verification_type, avatar_url')
            .eq('id', session.user.id)
            .single();

          const role = profile?.role || 'member';
          const isAdmin = role === 'admin';
          const fullName = profile?.full_name || 'Akun';
          const initials = fullName.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();

          // Hide guest-only elements
          document.querySelectorAll('.nav-guest-only').forEach(el => el.classList.add('hidden'));

          // ── Notification Bell ──
          const notifArea = document.getElementById('nav-notif-area');
          if (notifArea) {
            notifArea.innerHTML = `
              <button id="notif-bell-btn" class="relative rounded-lg p-2 text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800" aria-label="Notifikasi">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                <span id="notif-badge" class="absolute -top-0.5 -right-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white" style="display:none"></span>
              </button>
              <div id="notif-panel" class="invisible absolute right-0 top-full z-50 mt-1 w-80 max-h-[400px] overflow-y-auto translate-y-1 rounded-xl border border-gray-200 bg-white py-1.5 opacity-0 shadow-xl transition-all duration-150">
                <div class="flex items-center justify-between px-4 py-2 border-b border-gray-100">
                  <span class="text-sm font-bold text-gray-800">Notifikasi</span>
                  <button id="notif-mark-all" class="text-xs font-medium text-paroki-600 hover:text-paroki-800 hover:underline">Tandai semua dibaca</button>
                </div>
                <div id="notif-list" class="divide-y divide-gray-50"></div>
              </div>
            `;
            notifArea.classList.remove('hidden');
            notifArea.classList.add('nav-dropdown', 'relative');

            const notifBtn = notifArea.querySelector('#notif-bell-btn');
            const notifPanel = notifArea.querySelector('#notif-panel');
            const notifBadge = notifArea.querySelector('#notif-badge');
            const notifList = notifArea.querySelector('#notif-list');

            async function loadNotifs() {
              const { data: notifs } = await sb.from('notifications').select('*').order('created_at', { ascending: false }).limit(20);
              const unread = notifs?.filter(n => !n.is_read).length || 0;
              if (unread > 0) { notifBadge.textContent = unread > 9 ? '9+' : unread; notifBadge.style.display = 'flex'; }
              else { notifBadge.style.display = 'none'; }

              if (!notifs || notifs.length === 0) {
                notifList.innerHTML = '<div class="px-4 py-8 text-center text-sm text-gray-400">Belum ada notifikasi</div>';
                return;
              }
              notifList.innerHTML = notifs.map(n => {
                const esc = (s) => String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
                const time = new Date(n.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
                const dot = n.is_read ? '' : '<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-paroki-500"></span>';
                const safeLink = /^[\/a-zA-Z0-9\-._~%!$&'()*+,;=:@]*$/.test(n.link||'') ? (n.link || '#') : '#';
                return `<a href="${safeLink}" data-id="${esc(n.id)}" class="notif-item flex gap-2.5 px-4 py-3 transition hover:bg-paroki-50 ${n.is_read ? 'opacity-60' : ''}">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-800">${esc(n.title)}</p>
                    <p class="mt-0.5 text-xs text-gray-500 line-clamp-2">${esc(n.message)}</p>
                    <p class="mt-1 text-[10px] text-gray-400">${esc(time)}</p>
                  </div>${dot}
                </a>`;
              }).join('');

              // Wire mark-as-read on click
              notifList.querySelectorAll('.notif-item').forEach(el => {
                el.addEventListener('click', async (e) => {
                  const id = el.dataset.id;
                  await sb.from('notifications').update({ is_read: true }).eq('id', id);
                });
              });
            }

            loadNotifs();

            // Realtime: update badge when new notification arrives
            sb.channel('notifications')
              .on('postgres_changes', { event: '*', schema: 'public', table: 'notifications', filter: 'user_id=eq.' + session.user.id }, () => loadNotifs())
              .subscribe();

            // Toggle panel
            notifBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              if (notifPanel.classList.contains('opacity-0')) {
                notifPanel.classList.remove('invisible', 'opacity-0', 'translate-y-1');
                notifPanel.classList.add('opacity-100', 'translate-y-0');
              } else {
                notifPanel.classList.add('invisible', 'opacity-0', 'translate-y-1');
                notifPanel.classList.remove('opacity-100', 'translate-y-0');
              }
            });

            // Close on outside click
            document.addEventListener('click', (e) => {
              if (!notifArea.contains(e.target)) {
                notifPanel.classList.add('invisible', 'opacity-0', 'translate-y-1');
                notifPanel.classList.remove('opacity-100', 'translate-y-0');
              }
            });

            // Mark all as read
            notifArea.querySelector('#notif-mark-all')?.addEventListener('click', async () => {
              await sb.from('notifications').update({ is_read: true }).eq('user_id', session.user.id).eq('is_read', false);
              loadNotifs();
            });
          }

          // ── Desktop: Akun dropdown ──
          const desktopArea = document.getElementById('nav-auth-area');
          const desktopButtons = document.getElementById('nav-auth-buttons');

          if (desktopArea) {
            desktopArea.innerHTML = `
              <button class="nav-dd-btn flex items-center gap-1.5 rounded-lg p-1 pr-2 transition hover:bg-paroki-50">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-paroki-900 text-xs font-bold text-white overflow-hidden">${profile?.avatar_url ? `<img src="${profile.avatar_url}" alt="" class="h-8 w-8 object-cover rounded-full" />` : initials}</span>
                <svg class="h-3.5 w-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="nav-dd-menu invisible absolute right-0 top-full z-50 mt-1 w-52 translate-y-1 rounded-xl border border-gray-200 bg-white py-1.5 opacity-0 shadow-lg transition-all duration-150">
                <a href="/dashboard" class="block px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">Dashboard</a>
                ${isAdmin ? '<a href="/admin" class="block px-4 py-2.5 text-sm font-medium text-paroki-700 hover:bg-paroki-50">Admin Panel</a>' : ''}
                <div class="my-1 border-t border-gray-100"></div>
                <button onclick="(async()=>{await sb.auth.signOut();window.location.href='/'})()" class="block w-full px-4 py-2.5 text-left text-sm font-medium text-red-600 hover:bg-red-50">Keluar</button>
              </div>
            `;
            desktopArea.classList.remove('hidden');
            desktopArea.classList.add('relative', 'nav-dropdown');

            // Wire up the newly injected dropdown
            const ddBtn = desktopArea.querySelector('.nav-dd-btn');
            const ddMenu = desktopArea.querySelector('.nav-dd-menu');
            if (ddBtn && ddMenu) {
              const open = () => { ddMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1'); ddMenu.classList.add('opacity-100', 'translate-y-0'); };
              const close = () => { ddMenu.classList.add('invisible', 'opacity-0', 'translate-y-1'); ddMenu.classList.remove('opacity-100', 'translate-y-0'); };
              ddBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                document.querySelectorAll('.nav-dd-menu').forEach((m) => { if (m !== ddMenu) { m.classList.add('invisible', 'opacity-0', 'translate-y-1'); m.classList.remove('opacity-100', 'translate-y-0'); } });
                if (ddMenu.classList.contains('opacity-0')) open(); else close();
              });
              desktopArea.addEventListener('mouseenter', open);
              desktopArea.addEventListener('mouseleave', close);
            }
          }
          if (desktopButtons) desktopButtons.classList.add('hidden');

          // ── Mobile auth area ──
          const mobileArea = document.getElementById('mobile-auth-area');
          const mobileGuest = document.getElementById('mobile-auth-guest');
          if (mobileArea) {
            mobileArea.innerHTML = `
              <a href="/dashboard" class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">
                <svg class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                Dashboard
              </a>
              ${isAdmin ? '<a href="/admin" class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-bold text-paroki-700 hover:bg-paroki-50"><svg class="h-4 w-4 text-paroki-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z"/></svg>Admin Panel</a>' : ''}
              <button onclick="(async()=>{await sb.auth.signOut();window.location.href='/'})()" class="mt-1 flex items-center gap-2.5 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-red-600 hover:bg-red-50">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Keluar
              </button>
            `;
          }
          if (mobileGuest) mobileGuest.classList.add('hidden');

        } catch (e) {
          // Silently fail — guest view is default
        }
      }

      updateNav();
    </script>

    <!-- Impersonation banner: standalone, runs immediately from localStorage -->
    <script is:inline>
      (function() {
        var raw = localStorage.getItem('impersonation_admin_session');
        if (!raw) return;
        var data;
        try { data = JSON.parse(raw); } catch(e) { return; }
        if (!data || !data.access_token || !data.refresh_token) return;
        if (!data.expires_at || (data.expires_at * 1000) <= Date.now()) {
          localStorage.removeItem('impersonation_admin_session');
          return;
        }

        var adminPath = localStorage.getItem('impersonation_admin_path') || '/admin';

        var banner = document.createElement('div');
        banner.id = 'impersonation-banner';
        banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;display:flex;align-items:center;justify-content:center;gap:10px;background:#4f46e5;color:#fff;padding:8px 16px;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,0.2);font-family:system-ui,sans-serif';
        banner.innerHTML =
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m22 11-3 3-2-2"/></svg>' +
          '<span style="font-weight:500">Mode Impersonasi — Anda bukan admin</span>' +
          '<button id="restore-admin-btn" style="margin-left:8px;border:none;border-radius:6px;background:#fff;color:#4f46e5;padding:4px 12px;font-size:12px;font-weight:700;cursor:pointer">← Kembali ke Admin</button>';
        document.body.prepend(banner);
        document.body.style.paddingTop = '38px';

        document.getElementById('restore-admin-btn').addEventListener('click', function() {
          var btn = this;
          btn.textContent = 'Memulihkan...';
          btn.disabled = true;

          // window.sb is set by the auth-aware navbar script (updateNav)
          function doRestore(sb) {
            sb.auth.signOut().then(function() {
              return sb.auth.setSession({
                access_token: data.access_token,
                refresh_token: data.refresh_token
              });
            }).then(function() {
              localStorage.removeItem('impersonation_admin_session');
              localStorage.removeItem('impersonation_admin_path');
              window.location.href = adminPath;
            }).catch(function(e) {
              console.error('Restore failed:', e);
              localStorage.removeItem('impersonation_admin_session');
              localStorage.removeItem('impersonation_admin_path');
              window.location.href = '/masuk';
            });
          }

          // Wait for window.sb (set async by module script)
          var tries = 0;
          function checkSb() {
            if (window.sb) { doRestore(window.sb); return; }
            if (++tries > 50) { window.location.href = '/masuk'; return; } // 5s timeout
            setTimeout(checkSb, 100);
          }
          checkSb();
        });
      })();
    </script>
    <!-- PWA Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' })
            .then(reg => console.log('PWA: SW registered', reg.scope))
            .catch(err => console.warn('PWA: SW failed', err));
        });
      }
    </script>
  </body>
</html>
