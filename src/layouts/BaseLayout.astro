---
import '../styles/global.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description = 'Direktori usaha dan jasa UMKM umat Paroki St. Servatius. Saling mendukung ekonomi komunitas paroki.',
  image,
  canonical,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = 'UMKM St. Servatius';
const baseUrl = Astro.url.origin;
const isHomepage = !title || title === siteName;
const fullTitle = isHomepage ? siteName : `${title} | ${siteName}`;
const canonicalUrl = canonical || Astro.url.href;
const ogImage = image || `${baseUrl}/og-default.jpg`;
const year = new Date().getFullYear();

// Inject Supabase config for client-side
// In SSR: use the hardcoded publishable key (it's public, not secret)
// In client: window.__SUPABASE__ is set by this inline script
const sbUrl = 'https://vfqcydqmwhfelqizxzbi.supabase.co';
const sbKey = 'sb_publishable_jph_9XaA6S_pIuVdOYaTkA_TCak_Oz4';
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Basic meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots -->
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

    <!-- Theme color -->
    <meta name="theme-color" content="#15803d" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Blog UMKM St. Servatius" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: self-hosted via @fontsource (no external CDN) -->

    <!-- JSON-LD structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Load Supabase config from Worker runtime env (dynamic, not baked at build) -->
    <script is:inline define:vars={{ sbUrl, sbKey }}>
      window.__SUPABASE__ = { url: sbUrl, key: sbKey };
    </script>
  </head>
  <body>
    <!-- Top utility bar -->
    <div class="hidden bg-paroki-900 text-paroki-200 md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-1.5 text-xs">
        <p class="font-medium tracking-wide">Bersatu Membangun Ekonomi Umat Paroki St. Servatius</p>
        <div class="flex items-center gap-4">
          <a href="https://wa.me/6281234567890" class="flex items-center gap-1.5 transition hover:text-white">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/></svg>
            <span>Hubungi Kami</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main header -->
    <header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 shadow-soft backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2.5">
        <!-- Logo + site name -->
        <a href="/" class="flex items-center gap-3">
          <img src="/logo-umkm-nav.png" alt="Logo UMKM St. Servatius" class="h-14 w-14 rounded-2xl object-cover shadow-sm ring-1 ring-gray-200 transition hover:shadow-md md:h-16 md:w-16" />
          <span class="flex flex-col leading-tight">
            <span class="font-display text-base font-extrabold tracking-tight text-ink md:text-lg">UMKM St. Servatius</span>
            <span class="text-xs font-medium text-paroki-600 md:text-[13px]">Paroki Kampung Sawah</span>
          </span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden items-center gap-1 md:flex">
          <a href="/umkm" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:bg-paroki-50 hover:text-paroki-800">UMKM</a>
          <a href="/produk" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:bg-paroki-50 hover:text-paroki-800">Produk</a>
          <a href="/bazar" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:bg-paroki-50 hover:text-paroki-800">Bazar</a>

          <!-- Dropdown: Artikel [Berita, Blog] -->
          <div class="relative nav-dropdown" id="dd-artikel">
            <button class="nav-dd-btn flex items-center gap-1 rounded-lg px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:bg-paroki-50 hover:text-paroki-800">
              Artikel
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-dd-menu invisible absolute left-0 top-full z-50 mt-1.5 w-48 translate-y-1 rounded-2xl border border-gray-100 bg-white py-2 opacity-0 shadow-xl transition-all duration-150">
              <a href="/berita" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-paroki-50 hover:text-paroki-800">
                <svg class="h-4 w-4 text-paroki-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9.2a2 2 0 0 1 .559-1.38l1.441-1.42M18 14h-8M15 18h-5M10 6h8v4h-8V6Z"/></svg>
                Berita
              </a>
              <a href="/blog" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-paroki-50 hover:text-paroki-800">
                <svg class="h-4 w-4 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v14M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H3ZM14 12a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-9Z"/></svg>
                Blog UMKM
              </a>
            </div>
          </div>

          <!-- Logged out: Masuk + Daftar -->
          <div id="nav-auth-buttons" class="nav-guest-only flex items-center gap-2 border-l border-gray-200 pl-3 ml-2">
            <a href="/masuk" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-gray-600 transition hover:bg-paroki-50 hover:text-paroki-800">Masuk</a>
            <a href="/daftar" class="inline-flex items-center gap-1.5 rounded-xl bg-gold-500 px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-gold-600 hover:shadow-md active:translate-y-px">Daftar</a>
          </div>

          <!-- Logged in: Akun dropdown (populated by script) -->
          <div id="nav-auth-area" class="hidden"></div>
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="rounded-xl p-2 text-gray-700 transition hover:bg-gray-100 md:hidden"
          aria-label="Buka menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white px-4 py-3 md:hidden">
        <div class="flex flex-col gap-1">
          <a href="/umkm" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-700 hover:bg-paroki-50">UMKM</a>
          <a href="/produk" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-700 hover:bg-paroki-50">Produk</a>
          <a href="/bazar" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-700 hover:bg-paroki-50">Bazar</a>
          <a href="/berita" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-700 hover:bg-paroki-50">Berita</a>
          <a href="/blog" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-700 hover:bg-paroki-50">Blog UMKM</a>
          <!-- Mobile auth area (populated by script) -->
          <div id="mobile-auth-area" class="mt-2 border-t border-gray-100 pt-2 flex flex-col gap-1"></div>
          <div id="mobile-auth-guest" class="nav-guest-only flex flex-col gap-1">
            <a href="/masuk" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-700 hover:bg-paroki-50">Masuk</a>
            <a href="/daftar" class="mt-1 rounded-xl bg-gold-500 px-3 py-2.5 text-center text-sm font-bold text-white">Daftar</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer — deep green -->
    <footer class="bg-paroki-900 text-paroki-100">
      <div class="mx-auto max-w-6xl px-4 py-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="max-w-sm">
            <div class="flex items-center gap-3">
              <img src="/logo-umkm-nav.png" alt="Logo UMKM St. Servatius" class="h-20 w-20 rounded-2xl object-cover shadow-lg ring-1 ring-white/20" />
              <div class="flex flex-col">
                <span class="font-display text-lg font-bold text-white">{siteName}</span>
                <span class="text-xs font-medium text-paroki-300">Paroki Kampung Sawah</span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-paroki-200">
              Direktori usaha dan jasa dari umat Paroki St. Servatius, Kampung Sawah. Saling mendukung ekonomi komunitas paroki.
            </p>
          </div>
          <div class="flex flex-col gap-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-paroki-300">Jelajahi</span>
            <a href="/umkm" class="text-paroki-100 transition hover:text-white">UMKM</a>
            <a href="/produk" class="text-paroki-100 transition hover:text-white">Produk</a>
            <a href="/berita" class="text-paroki-100 transition hover:text-white">Berita</a>
            <a href="/blog" class="text-paroki-100 transition hover:text-white">Blog</a>
            <a href="/daftar" class="text-paroki-100 transition hover:text-white">Daftarkan Usaha</a>
            <a href="/dashboard" class="text-paroki-100 transition hover:text-white">Dashboard</a>
          </div>
        </div>
        <div class="mt-8 border-t border-white/10 pt-5">
          <p class="text-xs text-paroki-300">
            © {year} {siteName} · Paroki Santo Servatius, Kampung Sawah
          </p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle + Desktop dropdowns -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');

      function setMenuOpen(open: boolean) {
        if (!menu || !btn) return;
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
      }

      btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.contains('hidden') === false;
        setMenuOpen(!isOpen);
      });

      // Close mobile menu when a link inside it is clicked
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenuOpen(false)));

      // Escape closes mobile menu and all dropdowns
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setMenuOpen(false);
          document.querySelectorAll('.nav-dd-menu').forEach((m) => {
            m.classList.add('invisible', 'opacity-0', 'translate-y-1');
            m.classList.remove('opacity-100', 'translate-y-0');
          });
        }
      });

      // Generic dropdown handler — works for ALL .nav-dropdown elements
      document.querySelectorAll('.nav-dropdown').forEach((dd) => {
        const ddBtn = dd.querySelector('.nav-dd-btn');
        const ddMenu = dd.querySelector('.nav-dd-menu');
        if (!ddBtn || !ddMenu) return;

        const open = () => {
          ddMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1');
          ddMenu.classList.add('opacity-100', 'translate-y-0');
          ddBtn?.setAttribute('aria-expanded', 'true');
        };
        const close = () => {
          ddMenu.classList.add('invisible', 'opacity-0', 'translate-y-1');
          ddMenu.classList.remove('opacity-100', 'translate-y-0');
          ddBtn?.setAttribute('aria-expanded', 'false');
        };

        ddBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          // Close all other dropdowns first
          document.querySelectorAll('.nav-dd-menu').forEach((m) => {
            if (m !== ddMenu) {
              m.classList.add('invisible', 'opacity-0', 'translate-y-1');
              m.classList.remove('opacity-100', 'translate-y-0');
            }
          });
          if (ddMenu.classList.contains('opacity-0')) open(); else close();
        });
        dd.addEventListener('mouseenter', open);
        dd.addEventListener('mouseleave', close);
        // Keyboard: Enter/Space already handled by <button>, Escape closes
        ddBtn.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      });

      // Close all dropdowns on outside click
      document.addEventListener('click', () => {
        document.querySelectorAll('.nav-dd-menu').forEach((m) => {
          m.classList.add('invisible', 'opacity-0', 'translate-y-1');
          m.classList.remove('opacity-100', 'translate-y-0');
        });
      });
    </script>

    <!-- Auth-aware navbar -->
    <script type="module">
      import { createClient } from '@supabase/supabase-js';

      async function updateNav() {
        if (!window.__SUPABASE__) {
          setTimeout(updateNav, 200);
          return;
        }

        try {
          const sb = createClient(window.__SUPABASE__.url, window.__SUPABASE__.key, { auth: { persistSession: true } });
          window.sb = sb;

          const { data: { session } } = await sb.auth.getSession();

          if (!session) {
            // Guest: Masuk + Daftar already visible by default
            return;
          }

          // Logged in: fetch profile
          const { data: profile } = await sb
            .from('profiles')
            .select('full_name, role, verification_status, verification_type')
            .eq('id', session.user.id)
            .single();

          const role = profile?.role || 'member';
          const isAdmin = role === 'admin';
          const fullName = profile?.full_name || 'Akun';
          const initials = fullName.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();

          // Hide guest-only elements
          document.querySelectorAll('.nav-guest-only').forEach(el => el.classList.add('hidden'));

          // ── Desktop: Akun dropdown ──
          const desktopArea = document.getElementById('nav-auth-area');
          const desktopButtons = document.getElementById('nav-auth-buttons');

          if (desktopArea) {
            desktopArea.innerHTML = `
              <button class="nav-dd-btn flex items-center gap-2 rounded-lg border border-gray-200 px-2.5 py-1.5 text-sm font-medium text-gray-700 transition hover:bg-paroki-50">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-paroki-900 text-xs font-bold text-white">${initials}</span>
                <span class="max-w-[100px] truncate">${fullName}</span>
                <svg class="h-3.5 w-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="nav-dd-menu invisible absolute right-0 top-full z-50 mt-1 w-52 translate-y-1 rounded-xl border border-gray-200 bg-white py-1.5 opacity-0 shadow-lg transition-all duration-150">
                <a href="/dashboard" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">
                  <svg class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                  Dashboard
                </a>
                ${isAdmin ? '<a href="/admin" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-paroki-700 hover:bg-paroki-50"><svg class="h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>Admin Panel</a>' : ''}
                <div class="my-1 border-t border-gray-100"></div>
                <button onclick="(async()=>{await sb.auth.signOut();window.location.href='/'})()" class="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-red-600 hover:bg-red-50">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                  Keluar
                </button>
              </div>
            `;
            desktopArea.classList.remove('hidden');
            desktopArea.classList.add('relative', 'nav-dropdown');

            // Wire up the newly injected dropdown
            const ddBtn = desktopArea.querySelector('.nav-dd-btn');
            const ddMenu = desktopArea.querySelector('.nav-dd-menu');
            if (ddBtn && ddMenu) {
              const open = () => { ddMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1'); ddMenu.classList.add('opacity-100', 'translate-y-0'); };
              const close = () => { ddMenu.classList.add('invisible', 'opacity-0', 'translate-y-1'); ddMenu.classList.remove('opacity-100', 'translate-y-0'); };
              ddBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                document.querySelectorAll('.nav-dd-menu').forEach((m) => { if (m !== ddMenu) { m.classList.add('invisible', 'opacity-0', 'translate-y-1'); m.classList.remove('opacity-100', 'translate-y-0'); } });
                if (ddMenu.classList.contains('opacity-0')) open(); else close();
              });
              desktopArea.addEventListener('mouseenter', open);
              desktopArea.addEventListener('mouseleave', close);
            }
          }
          if (desktopButtons) desktopButtons.classList.add('hidden');

          // ── Mobile auth area ──
          const mobileArea = document.getElementById('mobile-auth-area');
          const mobileGuest = document.getElementById('mobile-auth-guest');
          if (mobileArea) {
            mobileArea.innerHTML = `
              <a href="/dashboard" class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-paroki-50">📊 Dashboard</a>
              ${isAdmin ? '<a href="/admin" class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-bold text-paroki-700 hover:bg-paroki-50">⚙️ Admin Panel</a>' : ''}
              <button onclick="(async()=>{await sb.auth.signOut();window.location.href='/'})()" class="mt-1 flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-medium text-red-600 hover:bg-red-50">
                🚪 Keluar
              </button>
            `;
          }
          if (mobileGuest) mobileGuest.classList.add('hidden');

        } catch (e) {
          // Silently fail — guest view is default
        }
