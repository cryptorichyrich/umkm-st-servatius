---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Direktori UMKM Paroki',
  description = 'Temukan usaha dan jasa dari umat paroki kita. Support ekonomi komunitas paroki.',
} = Astro.props;

const siteName = 'UMKM Paroki';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>
  </head>
  <body>
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-paroki-200/60 bg-paroki-50/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-bold text-paroki-800">
          <span class="text-2xl">⛪</span>
          <span class="text-lg font-serif">{siteName}</span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden items-center gap-6 md:flex">
          <a href="/direktori" class="text-sm font-medium text-paroki-700 hover:text-paroki-900">Direktori</a>
          <a href="/#kategori" class="text-sm font-medium text-paroki-700 hover:text-paroki-900">Kategori</a>
          <a href="/dashboard" class="text-sm font-medium text-paroki-700 hover:text-paroki-900">Dashboard</a>
          <a
            href="/daftar"
            class="rounded-lg bg-paroki-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-paroki-700"
          >
            Daftarkan Usaha
          </a>
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="rounded-lg p-2 text-paroki-700 hover:bg-paroki-100 md:hidden"
          aria-label="Menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-paroki-200 bg-paroki-50 px-4 py-3 md:hidden">
        <div class="flex flex-col gap-3">
          <a href="/direktori" class="text-sm font-medium text-paroki-700">Direktori</a>
          <a href="/#kategori" class="text-sm font-medium text-paroki-700">Kategori</a>
          <a href="/dashboard" class="text-sm font-medium text-paroki-700">Dashboard</a>
          <a href="/daftar" class="rounded-lg bg-paroki-600 px-4 py-2 text-center text-sm font-semibold text-white">
            Daftarkan Usaha
          </a>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-paroki-200 bg-paroki-100/50">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
          <div class="flex items-center gap-2 text-paroki-700">
            <span class="text-xl">⛪</span>
            <span class="font-serif font-semibold">{siteName}</span>
          </div>
          <p class="text-center text-xs text-paroki-600 sm:text-right">
            Mendukung ekonomi umat paroki.<br />
            © {new Date().getFullYear()} {siteName}. Dibuat dengan ❤️ untuk komunitas.
          </p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>
