---
import type { Business } from '../lib/supabase';

interface Props {
  business: Partial<Business>;
}

const { business } = Astro.props;

const logo = business.logo_url || '';
const categoryName = business.category?.name || '';
const categoryIcon = business.category?.icon || '📦';
const waLink = business.whatsapp
  ? `https://wa.me/${business.whatsapp.replace(/[^0-9]/g, '')}`
  : null;
---

<a
  href={`/umkm/${business.slug}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-paroki-200 bg-white shadow-sm transition hover:shadow-md hover:border-paroki-300"
>
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden bg-paroki-100">
    {logo ? (
      <img
        src={logo}
        alt={business.name}
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-4xl text-paroki-300">
        {categoryIcon}
      </div>
    )}
    {categoryName && (
      <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-medium text-paroki-700 backdrop-blur-sm">
        {categoryIcon} {categoryName}
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-serif text-lg font-semibold leading-snug text-paroki-900 break-words">
      {business.name}
    </h3>
    {business.description && (
      <p class="mt-1 line-clamp-2 text-sm text-paroki-600">
        {business.description}
      </p>
    )}
    <div class="mt-3 flex items-center gap-3 text-xs text-paroki-500">
      {business.area && (
        <span class="flex items-center gap-1">
          📍 {business.area}
        </span>
      )}
      {waLink && (
        <span class="flex items-center gap-1 text-green-600">
          💬 WhatsApp
        </span>
      )}
    </div>
  </div>
</a>
